---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Résumé | Farand Mahazalfaa"
  description="Résumé of Farand Mahazalfaa, Data Science student working across data, design, software, and visual communication."
>
  <main class="resume-page">
    <div class="wrap resume-wrap">
      <header class="resume-head">
        <a class="back" href="/">← Portfolio</a>
        <div class="head-grid">
          <div>
            <p class="eyebrow">Résumé</p>
            <h1>Farand Diy Dat Mahazalfaa</h1>
          </div>
          <div class="contact">
            <a href="mailto:farand.dee@gmail.com">farand.dee@gmail.com</a>
            <a href="https://linkedin.com/in/farandee/" target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href="https://github.com/cerealtwist" target="_blank" rel="noopener">GitHub ↗</a>
          </div>
        </div>
        <p class="summary">Data Science student working across data analysis, software development, visual communication, and project leadership.</p>
      </header>

      <section class="resume-section">
        <div class="section-label">Education</div>
        <div class="section-body rows">
          <article class="row">
            <div class="row-main"><h2>Telkom University</h2><p>B.Sc. Data Science</p></div>
            <div class="row-side">Sep 2023 – Present</div>
            <p class="row-detail">Interests include data visualization, analytics, big data, machine learning, and time-series analysis. Astra 1st 2026 Scholarship Awardee and Telkom University Endowment Fund 2026 Awardee.</p>
          </article>
          <article class="row">
            <div class="row-main"><h2>SMK Telkom Purwokerto</h2><p>Software Engineering</p></div>
            <div class="row-side">Nov 2020 – May 2023</div>
            <p class="row-detail">Focused on database management, UI/UX design, web development, and object-oriented programming.</p>
          </article>
        </div>
      </section>

      <section class="resume-section">
        <div class="section-label">Experience</div>
        <div class="section-body rows">
          <article class="row">
            <div class="row-main"><h2>Astra Motor</h2><p>Project Consultant · Data & Systems Technical Lead</p></div>
            <div class="row-side">Jun 2026 – Present</div>
            <p class="row-detail">Leading technical development of AMDC Pocket across architecture, backend development, data preparation, sprint tracking, and stakeholder delivery.</p>
          </article>
          <article class="row">
            <div class="row-main"><h2>Outlier.ai</h2><p>AI Evaluation Specialist & Language Expert</p></div>
            <div class="row-side">Aug 2026 – Present</div>
            <p class="row-detail">Evaluating Speech-to-Speech multimodal AI for Indonesian localization through RLHF, adversarial red-teaming, and multi-turn auditing.</p>
          </article>
          <article class="row">
            <div class="row-main"><h2>EON Reality</h2><p>Product Development Intern</p></div>
            <div class="row-side">Jan 2026 – Apr 2026</div>
            <p class="row-detail">Worked on RAG-based business workflow tooling with Python, FastAPI, and PostgreSQL, alongside product research and AI builder evaluation.</p>
          </article>
          <article class="row">
            <div class="row-main"><h2>Telkom University Language Center</h2><p>Tutor · Bahasa Indonesia for Foreign Speakers (BIPA)</p></div>
            <div class="row-side">May 2025 – Jan 2026</div>
            <p class="row-detail">Taught Indonesian at A1–A2 levels to international scholarship awardees through the BIPA program.</p>
          </article>
        </div>
      </section>

      <section class="resume-section">
        <div class="section-label">Leadership</div>
        <div class="section-body rows">
          <article class="row">
            <div class="row-main"><h2>SRE Telkom University</h2><p>Director of Multimedia</p></div>
            <div class="row-side">Dec 2024 – Dec 2025</div>
            <p class="row-detail">Led Social Media and Creative Media while rebuilding the organization’s visual identity and content workflow.</p>
          </article>
          <article class="row">
            <div class="row-main"><h2>IEEE Telkom University</h2><p>Creative & Information Content Manager</p></div>
            <div class="row-side">Jan 2025 – Jan 2026</div>
            <p class="row-detail">Produced visual explainers and built content planning systems for technical communication.</p>
          </article>
        </div>
      </section>

      <section class="resume-section">
        <div class="section-label">Tools</div>
        <div class="section-body tool-lines">
          <p><span>Data</span> Python · SQL · PostgreSQL · BigQuery · Tableau · Power BI · Excel · Jupyter · Google Colab</p>
          <p><span>Development</span> Django · FastAPI · GitHub · GCP</p>
          <p><span>Design</span> Figma · Adobe Illustrator · Adobe Photoshop · Adobe XD</p>
          <p><span>Planning</span> Jira · Notion · Trello</p>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .resume-page { padding: 110px 0 80px; }
  .resume-wrap { max-width: 1080px; }
  .back { font-size: .82rem; color: var(--text-secondary); }
  .resume-head { padding: 34px 0 64px; border-bottom: 1px solid var(--line); }
  .head-grid { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; margin-top: 44px; }
  .eyebrow { margin: 0 0 12px; font-size: .74rem; text-transform: uppercase; letter-spacing: .09em; color: var(--text-tertiary); }
  h1 { margin: 0; font-size: clamp(2.7rem, 7vw, 6.2rem); line-height: .96; letter-spacing: -.055em; font-weight: 600; max-width: 10ch; }
  .contact { display: flex; flex-direction: column; gap: 7px; align-items: flex-end; font-size: .86rem; color: var(--text-secondary); }
  .summary { margin: 34px 0 0; max-width: 58ch; color: var(--text-secondary); font-size: 1.12rem; }
  .resume-section { display: grid; grid-template-columns: 160px 1fr; gap: 48px; padding: 48px 0; border-bottom: 1px solid var(--line); }
  .section-label { font-size: .76rem; text-transform: uppercase; letter-spacing: .09em; color: var(--text-tertiary); }
  .rows { border-top: 1px solid var(--text); }
  .row { display: grid; grid-template-columns: 1fr auto; gap: 14px 32px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .row-main h2 { margin: 0 0 3px; font-size: 1.15rem; font-weight: 600; letter-spacing: -.02em; }
  .row-main p, .row-side, .row-detail { margin: 0; }
  .row-main p { color: var(--text-secondary); }
  .row-side { font-size: .8rem; color: var(--text-tertiary); white-space: nowrap; }
  .row-detail { grid-column: 1 / -1; max-width: 72ch; color: var(--text-secondary); font-size: .94rem; }
  .tool-lines { border-top: 1px solid var(--text); }
  .tool-lines p { display: grid; grid-template-columns: 120px 1fr; gap: 20px; margin: 0; padding: 18px 0; border-bottom: 1px solid var(--line); color: var(--text-secondary); }
  .tool-lines span { color: var(--text); font-weight: 550; }
  @media (max-width: 720px) {
    .head-grid, .resume-section { grid-template-columns: 1fr; }
    .contact { align-items: flex-start; }
    .resume-section { gap: 22px; }
    .row { grid-template-columns: 1fr; }
    .row-side, .row-detail { grid-column: 1; }
    .tool-lines p { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
