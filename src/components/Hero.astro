---
const fullName = 'Farand Mahazalfaa';
---

<header class="hero" id="top">
  <svg class="hero-signal" viewBox="0 0 1200 260" preserveAspectRatio="none" aria-hidden="true">
    <polyline
      fill="none"
      stroke="#141312"
      stroke-width="2"
      points="0,190 40,175 80,195 120,140 160,160 200,110 240,130 280,90 320,120 360,70 400,100 440,60 480,95 520,40 560,80 600,30 640,65 680,20 720,55 760,15 800,50 840,10 880,45 920,25 960,5 1000,40 1040,15 1080,35 1120,10 1160,25 1200,0"
    />
  </svg>
  <div class="wrap">
    <h1 class="name" id="hero-name" data-full-name={fullName}>{fullName}</h1>
    <p class="hero-sub">
      Data Science student at Telkom University. I turn noisy signals, trade flows, prices, city
      grids, into forecasts and decisions worth acting on.
    </p>
    <div class="hero-meta">
      <div><span>6th</span> semester, B.Sc. Data Science</div>
      <div><span>Astra 1st 2026</span> Scholarship Awardee</div>
    </div>

    <div class="hero-contact">
      <a href="mailto:farand.dee@gmail.com" aria-label="Email Farand">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m2 6 10 7L22 6" />
        </svg>
        Email
      </a>
      <a href="https://github.com/cerealtwist" target="_blank" rel="noopener" aria-label="Farand's GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
        GitHub
      </a>
      <a href="https://linkedin.com/in/farandee/" target="_blank" rel="noopener" aria-label="Farand's LinkedIn">
        <span class="li-mark">in</span>
        LinkedIn
      </a>
    </div>
  </div>
  <div class="scroll-cue">Scroll</div>
</header>

<script>
  const el = document.getElementById('hero-name');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !prefersReducedMotion) {
    const fullText = el.dataset.fullName || el.textContent || '';
    el.textContent = '';
    el.classList.add('typing');
    let i = 0;
    const type = () => {
      if (i <= fullText.length) {
        el.textContent = fullText.slice(0, i);
        i++;
        setTimeout(type, 68);
      } else {
        el.classList.remove('typing');
        el.classList.add('typed-done');
      }
    };
    setTimeout(type, 250);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 120px;
    padding-bottom: 80px;
  }
  .hero-signal {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8%;
    width: 100%;
    height: 40%;
    opacity: 0.055;
    pointer-events: none;
  }
  h1.name {
    font-size: clamp(2.7rem, 8.6vw, 7.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin: 0 0 28px 0;
    max-width: 14ch;
    min-height: 1.1em;
  }
  h1.name.typing::after,
  h1.name.typed-done::after {
    content: '|';
    display: inline-block;
    margin-left: 2px;
    color: var(--accent);
    animation: blink 0.9s step-end infinite;
  }
  h1.name.typed-done::after {
    animation: blink 0.9s step-end infinite, fade-cursor 1.2s 4s forwards;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @keyframes fade-cursor {
    to { opacity: 0; }
  }

  .hero-sub {
    font-size: clamp(1.05rem, 2vw, 1.45rem);
    color: var(--text-secondary);
    max-width: 44ch;
    font-weight: 400;
    margin: 0 0 40px 0;
  }
  .hero-meta {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-weight: 500;
    margin-bottom: 36px;
  }
  .hero-meta span { color: var(--text); font-weight: 600; }

  .hero-contact { display: flex; gap: 22px; flex-wrap: wrap; }
  .hero-contact a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color 0.2s var(--ease);
  }
  .hero-contact a:hover { color: var(--accent); }
  .li-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    font-size: 10px;
    font-weight: 800;
    border: 1.5px solid currentColor;
    border-radius: 3px;
    line-height: 1;
  }

  .scroll-cue {
    position: absolute;
    bottom: 36px;
    left: var(--pad);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-tertiary);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .scroll-cue::after {
    content: '';
    width: 34px;
    height: 1px;
    background: var(--text-tertiary);
  }
</style>
