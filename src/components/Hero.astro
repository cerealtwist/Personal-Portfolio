---
---

<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-kicker reveal">Data Science · Design · Software</div>

    <div class="hero-main reveal">
      <h1>I make complex problems easier to <span>understand and use.</span></h1>
      <p>
        I'm Farand Mahazalfaa, a Data Science student at Telkom University working across
        analytics, product systems, visual communication, and urban data.
      </p>
    </div>
  </div>
</header>

<style>
  .hero {
    min-height: 76svh;
    display: flex;
    align-items: center;
    padding: 132px 0 84px;
    background:
      radial-gradient(circle at 78% 20%, rgba(67, 137, 207, .13), transparent 28%),
      linear-gradient(180deg, #fbfdff 0%, var(--bg) 74%);
  }

  .hero-grid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(130px, .4fr) 1.6fr;
    gap: 32px;
    align-items: start;
  }

  .hero-kicker {
    padding-top: .8rem;
    color: var(--blue-deep);
    font-size: .78rem;
    font-weight: 650;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .hero-main h1 {
    margin: 0;
    max-width: 13ch;
    font-size: clamp(3rem, 6.25vw, 6.5rem);
    font-weight: 560;
    line-height: .94;
    letter-spacing: -.055em;
  }

  .hero-main h1 span { color: var(--blue); }

  .hero-main p {
    margin: clamp(28px, 3.5vw, 46px) 0 0;
    max-width: 48ch;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .hero { min-height: auto; padding: 118px 0 72px; }
    .hero-grid { grid-template-columns: 1fr; gap: 18px; }
    .hero-main h1 { max-width: 11ch; font-size: clamp(2.8rem, 13vw, 4.8rem); }
  }
</style>
