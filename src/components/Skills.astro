---
import TechIcon from './TechIcon.astro';

const tools = [
  'Python', 'SQL', 'GCP', 'BigQuery', 'Excel', 'Power BI', 'Tableau',
  'Jupyter Notebook', 'Google Colab', 'Notion', 'Trello',
];
const design = ['Figma', 'Adobe Illustrator', 'Adobe Photoshop', 'Adobe XD', 'Canva'];
---

<section id="skills" class="alt">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="section-eyebrow">Skills</p>
      <h2>Tools I reach for</h2>
    </div>
    <div class="skills-grid reveal">
      <div>
        <div class="skill-cat-label">Data & Analysis</div>
        <div class="chip-row">
          {tools.map((tool) => (
            <span class="chip">
              <TechIcon name={tool} size={14} />
              {tool}
            </span>
          ))}
        </div>
      </div>
      <div>
        <div class="skill-cat-label">Design</div>
        <div class="chip-row">
          {design.map((tool) => (
            <span class="chip">
              <TechIcon name={tool} size={14} />
              {tool}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skills-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 48px; }
  .skill-cat-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    margin-bottom: 18px;
  }
  .chip-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; }

  @media (max-width: 700px) { .skills-grid { grid-template-columns: 1fr; } }
</style>
