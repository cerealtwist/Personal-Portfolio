---
const certifications = [
  {
    name: 'TOEIC Listening and Reading Test',
    org: 'The TOEIC Program',
    detail: 'Score 900/990 (Listening 475, Reading 425)',
    date: 'Sep 2024',
  },
  {
    name: 'Data Science in Retail: Market Basket Analysis',
    org: 'DQLab',
    detail: 'Applied Market Basket Analysis techniques to retail datasets.',
    date: 'Jul 2023',
  },
];
---

<section id="certifications">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="section-eyebrow">Certifications</p>
      <h2>Verified credentials</h2>
    </div>
    <div class="cert-grid reveal">
      {
        certifications.map((cert, i) => (
          <div class="cert-card">
            <!-- Replace with: <img src={`/images/cert-${i + 1}.jpg`} alt={cert.name} /> -->
            <div class="cert-media">
              <span>Add certificate scan (e.g. cert-{i + 1}.jpg)</span>
            </div>
            <div class="cert-name">{cert.name}</div>
            <div class="cert-org">{cert.org}</div>
            <div class="cert-detail">{cert.detail}</div>
            <div class="cert-date">{cert.date}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .cert-card {
    background: var(--bg-alt);
    border-radius: 16px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cert-media {
    background: var(--bg-deep);
    border-radius: 10px;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-align: center;
    margin-bottom: 14px;
  }
  .cert-media img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 10px; }
  .cert-media span { font-size: 0.75rem; font-weight: 500; color: var(--text-tertiary); }

  .cert-name { font-weight: 700; font-size: 1rem; }
  .cert-org { color: var(--text-secondary); font-size: 0.85rem; font-weight: 600; }
  .cert-detail { color: var(--text-tertiary); font-size: 0.85rem; }
  .cert-date { font-size: 0.75rem; color: var(--text-tertiary); font-weight: 600; margin-top: 6px; }

  @media (max-width: 700px) { .cert-grid { grid-template-columns: 1fr; } }
</style>
