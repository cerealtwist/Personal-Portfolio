---
---

<section id="contact">
  <div class="wrap contact-wrap">
    <div class="contact-heading reveal">
      <p class="section-eyebrow">Contact</p>
      <h2 class="contact-title">Have something worth figuring out together?</h2>
      <p class="contact-copy">
        I'm open to internships, project collaborations, and conversations around data products, analytics, software, and visual communication.
      </p>
    </div>

    <div class="contact-panel reveal">
      <form class="contact-form" id="contact-form">
        <div class="form-row">
          <label>
            Name
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>
        <label>
          Message
          <textarea name="message" rows="6" required></textarea>
        </label>
        <div class="form-actions">
          <button type="submit">Send via email ↗</button>
          <span>Opens your email app with the message pre-filled.</span>
        </div>
      </form>

      <aside class="contact-aside">
        <p class="aside-label">Elsewhere</p>
        <a class="primary-contact" href="mailto:farand.dee@gmail.com">farand.dee@gmail.com ↗</a>
        <a href="https://linkedin.com/in/farandee/" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="https://github.com/cerealtwist" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="/Farand_Mahazalfaa_CV.pdf" download>Résumé ↓</a>
      </aside>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    const subject = encodeURIComponent(`Portfolio inquiry from ${name || 'a visitor'}`);
    const body = encodeURIComponent(`${message}\n\nFrom: ${name}\nEmail: ${email}`);
    window.location.href = `mailto:farand.dee@gmail.com?subject=${subject}&body=${body}`;
  });
</script>

<style>
  #contact {
    padding-top: clamp(100px, 13vw, 170px);
    padding-bottom: clamp(74px, 10vw, 120px);
    background:
      radial-gradient(circle at 88% 18%, rgba(67, 137, 207, .14), transparent 24%),
      var(--bg);
  }
  .contact-wrap { display: flex; flex-direction: column; gap: clamp(46px, 6vw, 80px); }
  .contact-heading { display: grid; grid-template-columns: minmax(120px, .4fr) 1.6fr; gap: 28px; }
  .contact-heading .section-eyebrow { grid-column: 1; }
  .contact-title {
    grid-column: 2;
    font-size: clamp(2.7rem, 5.7vw, 5.8rem);
    font-weight: 550;
    letter-spacing: -.052em;
    line-height: .96;
    max-width: 12ch;
  }
  .contact-copy {
    grid-column: 2;
    max-width: 55ch;
    margin: 22px 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.35vw, 1.14rem);
  }

  .contact-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(220px, .65fr);
    gap: 0;
    overflow: hidden;
    border: 1px solid rgba(35, 95, 156, .13);
    border-radius: 22px;
    background: rgba(255, 255, 255, .66);
    backdrop-filter: blur(18px) saturate(125%);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
    box-shadow: 0 18px 60px rgba(23, 75, 125, .07);
  }

  .contact-form { padding: clamp(26px, 4vw, 48px); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--blue-deep);
    font-size: .78rem;
    font-weight: 650;
    letter-spacing: .03em;
  }
  input,
  textarea {
    width: 100%;
    border: 1px solid rgba(35, 95, 156, .14);
    border-radius: 12px;
    background: rgba(255, 255, 255, .76);
    color: var(--text);
    font: inherit;
    padding: 13px 14px;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease), background .2s var(--ease);
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: rgba(35, 95, 156, .55);
    box-shadow: 0 0 0 4px rgba(35, 95, 156, .08);
    background: #fff;
  }
  textarea { resize: vertical; min-height: 150px; }
  .form-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 4px; }
  .form-actions button {
    border: 0;
    border-radius: 11px;
    background: var(--blue);
    color: #fff;
    font: inherit;
    font-size: .9rem;
    font-weight: 650;
    padding: 12px 16px;
    transition: background .2s var(--ease), transform .2s var(--ease);
  }
  .form-actions button:hover { background: var(--blue-deep); transform: translateY(-1px); }
  .form-actions span { color: var(--text-tertiary); font-size: .76rem; }

  .contact-aside {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 4vw, 48px);
    border-left: 1px solid rgba(35, 95, 156, .11);
    background: rgba(234, 242, 250, .62);
  }
  .aside-label {
    margin: 0 0 26px;
    color: var(--blue-deep);
    font-size: .76rem;
    font-weight: 650;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .contact-aside a {
    padding: 15px 0;
    border-bottom: 1px solid rgba(35, 95, 156, .12);
    color: var(--text-secondary);
    font-size: .9rem;
    transition: color .2s var(--ease), transform .2s var(--ease);
  }
  .contact-aside a:hover { color: var(--blue-deep); transform: translateX(3px); }
  .primary-contact { color: var(--text) !important; font-weight: 600; }

  @media (max-width: 820px) {
    .contact-heading { grid-template-columns: 1fr; gap: 14px; }
    .contact-heading .section-eyebrow,
    .contact-title,
    .contact-copy { grid-column: 1; }
    .contact-panel { grid-template-columns: 1fr; }
    .contact-aside { border-left: 0; border-top: 1px solid rgba(35, 95, 156, .11); }
  }

  @media (max-width: 560px) {
    .form-row { grid-template-columns: 1fr; gap: 0; }
  }
</style>
