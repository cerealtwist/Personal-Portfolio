<section id="contact">
  <div class="wrap contact-wrap">
    <p class="section-eyebrow reveal">Contact</p>
    <h2 class="contact-title reveal">Have something worth figuring out together?</h2>
    <p class="contact-copy reveal">
      I'm open to internships, project collaborations, and conversations around data products, analytics, software, and visual communication.
    </p>

    <div class="contact-links reveal">
      <a class="primary-contact" href="mailto:farand.dee@gmail.com">farand.dee@gmail.com ↗</a>
      <a href="https://linkedin.com/in/farandee/" target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href="https://github.com/cerealtwist" target="_blank" rel="noopener">GitHub ↗</a>
      <a href="/Farand_Mahazalfaa_CV.pdf" download>Résumé ↓</a>
    </div>
  </div>
</section>

<style>
  #contact { padding-top: clamp(100px, 14vw, 180px); padding-bottom: clamp(70px, 10vw, 120px); }
  .contact-wrap { display: flex; flex-direction: column; align-items: flex-start; }
  .contact-title {
    font-size: clamp(2.8rem, 7vw, 6.4rem);
    font-weight: 540;
    letter-spacing: -0.055em;
    line-height: .95;
    max-width: 12ch;
    margin: 0;
  }
  .contact-copy {
    max-width: 54ch;
    margin: 30px 0 50px;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
  }
  .contact-links {
    width: 100%;
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    border-top: 1px solid var(--text);
  }
  .contact-links a {
    min-height: 74px;
    display: flex;
    align-items: center;
    padding: 0 18px 0 0;
    border-bottom: 1px solid var(--line);
    color: var(--text-secondary);
    font-size: .92rem;
    transition: color .2s var(--ease), transform .2s var(--ease);
  }
  .contact-links a:hover { color: var(--text); transform: translateX(3px); }
  .primary-contact { color: var(--text) !important; font-weight: 550; }

  @media (max-width: 760px) {
    .contact-links { grid-template-columns: 1fr; }
    .contact-links a { min-height: 58px; }
  }
</style>
