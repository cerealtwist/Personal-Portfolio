---
// Sign up at https://formspree.io (free tier: 50 submissions/month), create
// a form, and paste its ID here. Until you do, the form will show an error
// on submit rather than silently losing messages.
const FORMSPREE_ID = 'YOUR_FORM_ID';
const formAction = `https://formspree.io/f/${FORMSPREE_ID}`;
---

<section id="contact">
  <div class="wrap contact-wrap">
    <p class="section-eyebrow reveal">Contact</p>
    <h2 class="contact-title reveal">Let's talk about data, or the next thing to build.</h2>

    <div class="contact-links reveal">
      <a href="mailto:farand.dee@gmail.com">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m2 6 10 7L22 6" />
        </svg>
        farand.dee@gmail.com
      </a>
      <a href="https://linkedin.com/in/farandee/" target="_blank" rel="noopener">
        <span class="li-mark">in</span>
        LinkedIn
      </a>
      <a href="https://github.com/cerealtwist" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
        GitHub
      </a>
    </div>

    <form class="contact-form reveal" id="contact-form" method="POST" action={formAction}>
      <input type="text" name="_gotcha" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="form-row">
        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
      </div>
      <label>
        Message
        <textarea name="message" rows="4" required></textarea>
      </label>
      <button type="submit" class="btn" id="contact-submit">Send message</button>
      <p class="form-status" id="form-status" role="status" hidden></p>
    </form>
  </div>
</section>

<script define:vars={{ formspreeConfigured: FORMSPREE_ID !== 'YOUR_FORM_ID' }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const submitBtn = document.getElementById('contact-submit');

  if (form && status && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!formspreeConfigured) {
        status.hidden = false;
        status.textContent =
          'The form is not wired up yet. Sign up at formspree.io and add the form ID (see README).';
        status.className = 'form-status error';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.reset();
          status.hidden = false;
          status.textContent = "Thanks, message sent. I'll get back to you soon.";
          status.className = 'form-status success';
        } else {
          throw new Error('Submission failed');
        }
      } catch {
        status.hidden = false;
        status.textContent = 'Something went wrong sending that. Try emailing directly instead.';
        status.className = 'form-status error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send message';
      }
    });
  }
</script>

<style>
  .contact-wrap { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; }
  .contact-title {
    font-size: clamp(2.2rem, 6vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    max-width: 16ch;
    margin: 0;
  }
  .contact-links { display: flex; gap: clamp(20px, 4vw, 40px); flex-wrap: wrap; }
  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    font-weight: 600;
    border-bottom: 1px solid transparent;
    padding-bottom: 3px;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .contact-links a:hover { border-color: var(--accent); color: var(--accent); }
  .li-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    font-size: 11px;
    font-weight: 800;
    border: 1.5px solid currentColor;
    border-radius: 3px;
    line-height: 1;
  }

  .contact-form {
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 8px;
  }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  label { display: flex; flex-direction: column; gap: 6px; font-size: 0.75rem; font-weight: 600; color: var(--text-tertiary); }
  input, textarea {
    font-family: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg-alt);
    border: none;
    border-radius: 10px;
    padding: 12px 14px;
    resize: vertical;
  }
  input:focus, textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .btn { align-self: flex-start; margin-top: 4px; }
  .form-status { font-size: 0.85rem; font-weight: 500; }
  .form-status.success { color: var(--accent); }
  .form-status.error { color: var(--text-tertiary); }

  @media (max-width: 560px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
