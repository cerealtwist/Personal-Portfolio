---
// Ring + dot cursor. Only on fine pointers; the native cursor stays if JS is off.
---

<div class="cursor" aria-hidden="true">
  <span class="cursor-ring"></span>
  <span class="cursor-dot"></span>
</div>

<script>
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('.cursor')!;
  const ring = el.querySelector<HTMLElement>('.cursor-ring')!;
  const dot = el.querySelector<HTMLElement>('.cursor-dot')!;

  const HOT = 'a, button, [role="button"], label, summary, [data-view-link]';
  const GRAB = '[data-face], .buddy-canvas';
  let x = -100, y = -100, rx = -100, ry = -100, raf = 0;

  function loop() {
    const k = still.matches ? 1 : 0.2;
    rx += (x - rx) * k;
    ry += (y - ry) * k;
    ring.style.translate = `${rx}px ${ry}px`;
    dot.style.translate = `${x}px ${y}px`;
    raf = Math.abs(x - rx) + Math.abs(y - ry) > 0.1 ? requestAnimationFrame(loop) : 0;
  }

  function onMove(e: PointerEvent) {
    if (e.pointerType !== 'mouse') return;
    x = e.clientX;
    y = e.clientY;
    el.classList.add('on');
    const t = e.target as Element;
    el.classList.toggle('hot', !!t.closest?.(HOT));
    el.classList.toggle('grab', !!t.closest?.(GRAB));
    el.classList.toggle('dark', !!t.closest?.('[data-panel], .dark-surface'));
    if (!raf) raf = requestAnimationFrame(loop);
  }

  function enable(on: boolean) {
    root.classList.toggle('has-cursor', on);
    if (on) {
      window.addEventListener('pointermove', onMove, { passive: true });
      window.addEventListener('pointerdown', () => el.classList.add('down'));
      window.addEventListener('pointerup', () => el.classList.remove('down'));
      document.addEventListener('pointerleave', () => el.classList.remove('on'));
    } else {
      window.removeEventListener('pointermove', onMove);
      el.classList.remove('on');
    }
  }

  enable(fine.matches);
  fine.addEventListener('change', (e) => enable(e.matches));
</script>

<style>
  .cursor {
    --c: #2261e9;
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity .2s;
  }
  .cursor.on { opacity: 1; }
  .cursor.dark { --c: #ffffff; }

  .cursor-ring, .cursor-dot {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
  }
  .cursor-ring {
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border: 1.5px solid var(--c);
    transition: scale .35s cubic-bezier(.16, 1, .3, 1), background-color .25s, border-color .25s;
  }
  .cursor-dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--c);
    transition: scale .25s cubic-bezier(.16, 1, .3, 1), background-color .25s;
  }

  .cursor.hot .cursor-ring {
    scale: 1.5;
    background: color-mix(in srgb, var(--c) 14%, transparent);
  }
  .cursor.hot .cursor-dot { scale: 0; }
  .cursor.grab .cursor-ring { scale: 2.1; border-style: dashed; }
  .cursor.down .cursor-ring { scale: .8; }
  .cursor.grab.down .cursor-ring { scale: 1.7; }
</style>

<style is:global>
  html.has-cursor,
  html.has-cursor * { cursor: none !important; }
</style>
