---
import { leadership } from '../data/experience';
import OrgLogo from './OrgLogo.astro';
---

<section id="leadership">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="section-eyebrow">Organizations</p>
      <h2>Leadership outside the workplace</h2>
    </div>
    <div class="lead-list">
      {
        leadership.map((item) => (
          <article class="lead-item reveal">
            <div class="lead-date">{item.date}</div>
            <OrgLogo name={item.org} logo={item.logo} size={40} />
            <div class="lead-copy">
              <p class="lead-role">{item.role}</p>
              <p class="lead-org">{item.org}</p>
              <p class="lead-desc">{item.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lead-list { border-top: 1px solid var(--line); }
  .lead-item {
    display: grid;
    grid-template-columns: 170px 40px minmax(0, 1fr);
    gap: 22px;
    padding: 32px 0 36px;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .lead-date {
    font-size: 0.82rem;
    color: var(--text-tertiary);
    font-weight: 500;
    padding-top: 8px;
  }
  .lead-role {
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 3px;
  }
  .lead-org { font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 14px; }
  .lead-desc { margin: 0; color: var(--text-secondary); max-width: 72ch; line-height: 1.58; }

  @media (max-width: 720px) {
    .lead-item { grid-template-columns: 40px 1fr; gap: 14px 16px; }
    .lead-date { grid-column: 1 / -1; padding-top: 0; }
  }
</style>
