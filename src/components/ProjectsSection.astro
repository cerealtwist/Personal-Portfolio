---
const work = [
  {
    number: '01',
    title: 'AMDC Pocket',
    year: '2026',
    role: 'Data & Systems Technical Lead',
    summary: 'Building an internal learning platform for Astra Motor around access, maintainability, and real organizational constraints.',
    className: 'work-wide amdc',
    href: '/work/amdc-pocket',
    media: 'placeholder',
    mediaLabel: 'AMDC Pocket hero / login screenshot needed',
  },
  {
    number: '02',
    title: 'Narapangan',
    year: '2026',
    role: 'Project Lead · Data Product & Full-Stack Development',
    summary: 'Turning volatile food-price forecasts into procurement decisions for small food businesses.',
    className: 'work-half narapangan',
    href: '/work/narapangan',
    media: 'image',
    mediaSrc: '/media/ss-narapangan.png',
    mediaLabel: 'Narapangan dashboard',
  },
  {
    number: '03',
    title: 'SRE Telkom University',
    year: '2023–2025',
    role: 'Director of Multimedia',
    summary: 'Rebuilding the visual identity and communication system of a growing sustainability organization.',
    className: 'work-half sre',
    href: '/work/sre-telkom',
    media: 'placeholder',
    mediaLabel: 'SRE rebrand collage needed',
  },
  {
    number: '04',
    title: 'Bandung Accessibility',
    year: '2026',
    role: 'Independent Spatial Analysis',
    summary: 'Mapping how unevenly everyday services are distributed across Bandung through proximity-based accessibility analysis.',
    className: 'work-wide bandung',
    href: '/work/bandung-accessibility',
    media: 'placeholder',
    mediaLabel: 'Redesigned Bandung accessibility map needed',
  },
  {
    number: '05',
    title: 'Comtrade Performance Analytics',
    year: '2026',
    role: 'Independent Analytics Project',
    summary: 'Reading Indonesia’s electrical machinery trade through supply-chain dependence, volatility, and logistics performance.',
    className: 'work-small comtrade',
    href: '/work/comtrade',
    media: 'placeholder',
    mediaLabel: 'Tableau overview image ready to add',
  },
];
---

<section id="projects" class="work-section">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="section-eyebrow">Selected work</p>
      <h2>Five projects, five different ways of solving problems.</h2>
    </div>

    <div class="work-grid">
      {work.map((item) => (
        <article class={`work-item ${item.className} reveal`}>
          <a class="work-link" href={item.href} data-cursor>
            <div class="work-media">
              {item.media === 'image' ? (
                <img src={item.mediaSrc} alt={item.mediaLabel} loading="lazy" />
              ) : (
                <div class="media-placeholder" aria-label={item.mediaLabel}>
                  <span>{item.mediaLabel}</span>
                </div>
              )}
            </div>

            <div class="work-meta">
              <div class="work-index">{item.number}</div>
              <div class="work-copy">
                <div class="work-title-row">
                  <h3>{item.title}</h3>
                  <span>{item.year}</span>
                </div>
                <p>{item.summary}</p>
                <div class="work-role">{item.role}</div>
              </div>
              <div class="work-arrow" aria-hidden="true">↗</div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 18px;
    row-gap: clamp(60px, 8vw, 116px);
  }

  .work-item { min-width: 0; }
  .work-wide { grid-column: 1 / -1; }
  .work-half:nth-of-type(2) { grid-column: 1 / 7; }
  .work-half:nth-of-type(3) { grid-column: 7 / -1; }
  .work-small { grid-column: 7 / -1; }

  .work-link { display: block; }
  .work-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f0f0ed;
  }

  .work-half .work-media { aspect-ratio: 4 / 3; }
  .work-small .work-media { aspect-ratio: 4 / 3; }

  .work-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .7s var(--ease), filter .4s var(--ease);
  }

  .media-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px),
      #f7f7f5;
    background-size: 32px 32px;
  }

  .media-placeholder span {
    padding: 9px 12px;
    background: var(--bg);
    color: var(--text-tertiary);
    font-size: .72rem;
    letter-spacing: .02em;
  }

  .work-meta {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--text);
  }

  .work-index,
  .work-arrow,
  .work-role,
  .work-title-row span {
    color: var(--text-secondary);
    font-size: .8rem;
  }

  .work-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }

  .work-copy h3 {
    margin: 0;
    font-size: clamp(1.4rem, 2.25vw, 2.35rem);
    font-weight: 560;
    letter-spacing: -.035em;
  }

  .work-copy p {
    margin: 10px 0 16px;
    max-width: 54ch;
    color: var(--text-secondary);
    font-size: .96rem;
  }

  .work-arrow { font-size: 1.1rem; transition: transform .25s var(--ease); }
  .work-link:hover .work-arrow { transform: translate(3px, -3px); }
  .work-link:hover .work-media img { transform: scale(1.015); }

  @media (max-width: 820px) {
    .work-half:nth-of-type(2),
    .work-half:nth-of-type(3),
    .work-small { grid-column: 1 / -1; }
    .work-half .work-media,
    .work-small .work-media { aspect-ratio: 16 / 10; }
  }

  @media (max-width: 560px) {
    .work-meta { grid-template-columns: 32px 1fr; }
    .work-arrow { display: none; }
    .work-title-row { align-items: flex-start; }
  }
</style>
