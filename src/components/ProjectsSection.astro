---
import ProjectCard from './ProjectCard.astro';
import NarapanganChart from './NarapanganChart.astro';
import { projects, githubUser } from '../data/projects';
import { narapanganModelResults, narapanganBestR2 } from '../data/narapanganResults';

// Fetched at BUILD time (runs on Vercel/CI during deploy), not in the visitor's
// browser. If GitHub's API is unreachable or rate-limited, we fall back to
// null stats rather than failing the whole build.
//
// Unauthenticated requests are capped at 60/hour, which repeated builds burn
// through fast. Set a GITHUB_TOKEN env var (a public-repo read-only classic
// PAT works fine) to raise that to 5000/hour. See README for setup.
const githubToken = import.meta.env.GITHUB_TOKEN;

async function fetchRepoStats(repo: string) {
  try {
    const headers: Record<string, string> = { Accept: 'application/vnd.github+json' };
    if (githubToken) headers.Authorization = `Bearer ${githubToken}`;

    const res = await fetch(`https://api.github.com/repos/${githubUser}/${repo}`, { headers });
    if (!res.ok) return { stars: null, updatedAt: null };
    const data = await res.json();
    return {
      stars: typeof data.stargazers_count === 'number' ? data.stargazers_count : null,
      updatedAt: typeof data.pushed_at === 'string' ? data.pushed_at : null,
    };
  } catch {
    return { stars: null, updatedAt: null };
  }
}

const projectsWithStats = [];
for (const project of projects) {
  const stats = await fetchRepoStats(project.repo);
  projectsWithStats.push({
    project,
    githubUrl: `https://github.com/${githubUser}/${project.repo}`,
    ...stats,
  });
}

const best = narapanganModelResults.reduce((a, b) => (a.mapePercent < b.mapePercent ? a : b));
const mostDirectional = narapanganModelResults.reduce((a, b) =>
  a.directionalAccuracyPercent > b.directionalAccuracyPercent ? a : b
);
---

<section id="projects">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="section-eyebrow">Projects</p>
      <h2>Selected work</h2>
    </div>

    <div class="flagship reveal">
      <div class="flagship-top">
        <div>
          <div class="flagship-tag">Capstone, S1 Sains Data, Telkom University</div>
          <h3>Narapangan</h3>
        </div>
      </div>
      <p>
        A decision support system for cabai rawit merah (bird's eye chili) price volatility in
        Bandung. Narapangan pairs deep learning price forecasts with generative AI to turn raw
        price signals into prescriptive procurement recommendations for local UMKM, replacing
        passive price-watching with tactical decisions.
      </p>

      <!-- Replace this block with: <div class="flagship-media"><img src="/images/narapangan-dashboard.jpg" alt="Narapangan dashboard" /></div> -->
      <div class="flagship-media">
        <span>Add project screenshot or mockup here (16:9, e.g. dashboard.jpg)</span>
      </div>

      <div class="stat-row">
        <div class="stat"><div class="stat-num">{best.mapePercent}%</div><div class="stat-label">MAPE, {best.model}</div></div>
        <div class="stat"><div class="stat-num">{mostDirectional.directionalAccuracyPercent}%</div><div class="stat-label">Directional accuracy, {mostDirectional.model}</div></div>
        <div class="stat"><div class="stat-num">{narapanganBestR2}</div><div class="stat-label">R&sup2;, {best.model}</div></div>
      </div>

      <p class="chart-intro">
        Five forecasting models were tested head to head. NBEATSx had the lowest error, NHITS
        called the direction of the next price move correctly 93.3% of the time. Hover or focus a
        model below for exact figures.
      </p>
      <NarapanganChart />

      <div class="flagship-foot">
        Kelompok 9, with Faaris Khairrudin, Enuka Lula Ansori, and Eliezer Sharon Hutabarat.
        Advised by Yeyen Hamidah, M.Pd.
      </div>
    </div>

    <div class="proj-grid reveal">
      {
        projectsWithStats.map(({ project, githubUrl, stars, updatedAt }) => (
          <ProjectCard project={project} githubUrl={githubUrl} stars={stars} updatedAt={updatedAt} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .flagship {
    background: var(--bg);
    padding: 44px;
    padding: clamp(36px, 5vw, 64px);
    border-radius: 22px;
    margin-bottom: 56px;
  }
  .flagship-top { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px; margin-bottom: 20px; }
  .flagship-tag { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.01em; color: var(--text-tertiary); }
  .flagship h3 { font-size: clamp(1.6rem, 3vw, 2.3rem); font-weight: 700; margin: 6px 0 0 0; letter-spacing: -0.01em; }
  .flagship p { font-size: 1.02rem; color: var(--text-secondary); max-width: 68ch; margin: 0 0 30px 0; }
  .chart-intro { margin-bottom: 20px; }

  .flagship-media {
    background: var(--bg-alt);
    border-radius: 14px;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
    overflow: hidden;
    padding: 24px;
    text-align: center;
  }
  .flagship-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .flagship-media span { font-size: 0.85rem; font-weight: 500; color: var(--text-tertiary); }

  .stat-row { display: flex; flex-wrap: wrap; gap: clamp(28px, 4vw, 56px); margin-bottom: 40px; }
  .stat { display: flex; flex-direction: column; gap: 4px; }
  .stat-num { font-size: clamp(1.5rem, 2.6vw, 2.1rem); font-weight: 700; letter-spacing: -0.01em; }
  .stat-label { font-size: 0.75rem; color: var(--text-tertiary); font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; }

  .flagship-foot { font-size: 0.85rem; color: var(--text-tertiary); margin-top: 24px; }

  .proj-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--bg-deep);
    border-radius: 22px;
    overflow: hidden;
  }

  @media (max-width: 900px) { .proj-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .proj-grid { grid-template-columns: 1fr; } }
</style>
