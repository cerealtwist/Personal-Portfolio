<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px var(--pad);
    border-bottom: 1px solid rgba(231,231,227,.8);
    background: rgba(252,252,251,.86);
    backdrop-filter: blur(14px);
  }

  .nav-mark {
    font-size: .84rem;
    font-weight: 650;
    letter-spacing: -.01em;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.3vw, 30px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    position: relative;
    color: var(--text-secondary);
    font-size: .8rem;
    font-weight: 500;
    transition: color .2s var(--ease);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -5px;
    height: 1px;
    background: currentColor;
    transition: right .28s var(--ease);
  }

  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { right: 0; }

  @media (max-width: 760px) {
    .site-nav { padding-top: 15px; padding-bottom: 15px; }
    .nav-mark { font-size: .78rem; }
    .nav-links li:nth-child(2),
    .nav-links li:nth-child(3),
    .nav-links li:last-child { display: none; }
  }
</style>
