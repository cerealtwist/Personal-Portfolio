---
import {
  siPython,
  siPandas,
  siApachespark,
  siGooglebigquery,
  siJavascript,
  siSvelte,
  siGooglecloud,
  siJupyter,
  siGooglecolab,
  siNotion,
  siTrello,
  siFigma,
  siGithub,
  siPostgresql,
  siDocker,
  siDjango,
  siFastapi,
  siJira,
} from 'simple-icons';

interface Props {
  name: string;
  size?: number;
}

const { name, size = 15 } = Astro.props;

const iconMap: Record<string, { path: string; title: string }> = {
  Python: siPython,
  Pandas: siPandas,
  Spark: siApachespark,
  BigQuery: siGooglebigquery,
  JavaScript: siJavascript,
  Svelte: siSvelte,
  GCP: siGooglecloud,
  'Jupyter Notebook': siJupyter,
  'Google Colab': siGooglecolab,
  Notion: siNotion,
  Trello: siTrello,
  Figma: siFigma,
  GitHub: siGithub,
  PostgreSQL: siPostgresql,
  Docker: siDocker,
  Django: siDjango,
  FastAPI: siFastapi,
  Jira: siJira,
};

const customIconMap: Record<string, string> = {
  Tableau: '/images/icons/tableau.svg',
  VertexAI: '/images/icons/vertex-ai.svg',
  SQL: '/images/icons/sql.svg',
  Excel: '/images/icons/excel.svg',
  'Power BI': '/images/icons/power-bi.svg',
};

const monogramMap: Record<string, string> = {
  Excel: 'Ex',
  Tableau: 'Tb',
  'Power BI': 'BI',
  'Adobe Illustrator': 'Ai',
  'Adobe Photoshop': 'Ps',
  'Adobe XD': 'Xd',
  LinkedIn: 'in',
  SQL: 'SQL',
  GIS: 'GIS',
  VertexAI: 'VA',
};

const icon = iconMap[name];
const customSrc = customIconMap[name];
const monogram = monogramMap[name] ?? name.slice(0, 2).toUpperCase();
---

{
  icon ? (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" role="img" aria-label={icon.title}>
      <path d={icon.path} />
    </svg>
  ) : customSrc ? (
    <span class="icon-wrap" style={`width:${size + 4}px;height:${size + 4}px;font-size:${size * 0.52}px;`}>
      <span class="monogram">{monogram}</span>
      <img
        class="custom-icon"
        src={customSrc}
        alt={name}
        loading="lazy"
        onload="this.previousElementSibling.style.display='none'; this.style.opacity='1';"
        onerror="this.remove();"
      />
    </span>
  ) : (
    <span class="monogram" style={`width:${size + 4}px;height:${size + 4}px;font-size:${size * 0.52}px;`} role="img" aria-label={name}>
      {monogram}
    </span>
  )
}

<style>
  .icon-wrap {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
  }
  .monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    flex-shrink: 0;
  }
  .custom-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
  }
</style>
