---
import { caseStudies, categories } from '../../data/caseStudies';
import { experience, leadership } from '../../data/experience';
import { toolGroups } from '../../data/tools';
import { profile } from '../../data/profile';
import TechIcon from '../TechIcon.astro';
import OrgLogo from '../OrgLogo.astro';
import { url } from '../../lib/url';

const CV = url('/Farand_Mahazalfaa_CV.pdf');
const works = caseStudies;
const total = String(works.length).padStart(2, '0');

const groups = [...new Set(works.map((w) => w.group))]
  .sort((a, b) => Number(b) - Number(a))
  .map((year) => ({ year, items: works.filter((w) => w.group === year) }));

const code = (w: (typeof works)[number]) =>
  `FM-${w.number}.${w.group.slice(-2)}/${w.slug.slice(0, 4).toUpperCase()}`;

const sideLinks = [
  { label: 'Experience', view: 'experience' },
  { label: 'Leadership', view: 'leadership' },
  { label: 'Toolkit', view: 'toolkit' },
  { label: 'About', view: 'about' },
];

// Floating elements on the home canvas: [x%, y%, parallax depth]
const floatTools = [
  { name: 'Python', x: 8, y: 10, d: 18 },
  { name: 'BigQuery', x: 34, y: 6, d: 10 },
  { name: 'Figma', x: 58, y: 13, d: 22 },
  { name: 'Django', x: 82, y: 7, d: 14 },
  { name: 'Tableau', x: 20, y: 33, d: 26 },
  { name: 'PostgreSQL', x: 47, y: 31, d: 12 },
];
const cursors = [
  { label: 'Data Scientist', color: '#ffd43b', ink: '#1a1a1a', x: 28, y: 20, d: 30 },
  { label: 'Tech Lead', color: '#20c997', ink: '#06261c', x: 62, y: 33, d: 20 },
  { label: 'Designer', color: '#f783ac', ink: '#3a0a1c', x: 80, y: 22, d: 24 },
  { label: 'Analyst', color: '#ff922b', ink: '#2e1500', x: 44, y: 44, d: 16 },
];
---

<div class="shell" data-shell>
  <!-- LEFT -->
  <aside class="left">
    <div class="left-inner">
      <header class="identity">
        <h1 class="name enter" style="--i:0">{profile.name}</h1>
        <p class="roles enter" style="--i:1">Data Science / Product Systems / Visual Communication</p>

        <div class="intro enter" style="--i:2">
          <div class="portrait">
            {profile.photo ? (
              <>
                <img src={url(profile.photo)} alt={`Portrait of ${profile.name}`} data-photo />
                <canvas data-photo-reveal aria-hidden="true"></canvas>
              </>
            ) : (
              <canvas data-avatar="mini" aria-label="Pixel avatar placeholder"></canvas>
            )}
          </div>
          <p>
            Hi, I'm Farand, a Data Science student at Telkom University working where analytics,
            software, and design overlap, making complex problems easier to understand and use.
            Reach me at <a href={`mailto:${profile.email}`}>{profile.email}</a>, or stay and look through the work.
          </p>
        </div>
      </header>

      <section class="works enter" style="--i:3" aria-labelledby="works-title">
        <h2 class="works-tab" id="works-title">Selected Works</h2>
        <div class="works-box">
          <div class="works-toolbar">
            <div class="filters" role="group" aria-label="Filter works by category">
              {categories.map((c) => (
                <button type="button" class="chip" data-filter={c.id} aria-pressed="false" title={c.label}>
                  <span class={`swatch swatch-${c.id}`} aria-hidden="true"></span>
                  {c.short}
                </button>
              ))}
            </div>
            <div class="view-toggle" role="group" aria-label="Layout">
              <button type="button" data-layout="list" aria-pressed="true" aria-label="List view">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h12v2H2zM2 7h12v2H2zM2 11h12v2H2z" /></svg>
              </button>
              <button type="button" data-layout="grid" aria-pressed="false" aria-label="Grid view">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2h5v5H2zM9 2h5v5H9zM2 9h5v5H2zM9 9h5v5H9z" /></svg>
              </button>
            </div>
          </div>

          <div class="works-scroll" data-works data-layout-mode="list">
            {groups.map((g) => (
              <div class="year-group" data-year-group>
                <p class="year"><span>{g.year}</span></p>
                <ul class="rows">
                  {g.items.map((w) => (
                    <li data-cats={w.categories.join(' ')}>
                      <a class="row" href={url(`/work/${w.slug}`)} data-view-link={`work/${w.slug}`}>
                        <span class="row-tag">{w.tag}</span>
                        <span class="row-body">
                          <span class="row-text">
                            <span class="row-title">{w.title}</span>
                            <span class="row-summary">{w.summary}</span>
                          </span>
                          <span class="row-thumb" aria-hidden="true">
                            {w.hero ? (
                              <img src={url(w.hero)} alt="" loading="lazy" />
                            ) : (
                              <canvas data-art data-seed={Number(w.number)} data-label={w.number} data-cols="96"></canvas>
                            )}
                          </span>
                        </span>
                        <span class="row-cats" aria-hidden="true">
                          {w.categories.map((c) => <span class={`swatch swatch-${c}`}></span>)}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <p class="empty" data-empty hidden>No work in this combination yet.</p>
          </div>
        </div>
      </section>

      <nav class="links enter" style="--i:4" aria-label="More about Farand">
        <a href="#home" data-view-link="home" class="home-link">Home</a>
        {sideLinks.map((l) => (
          <a href={`#${l.view}`} data-view-link={l.view}>{l.label}</a>
        ))}
        <a href={CV} download>Résumé</a>
        <a href="https://github.com/cerealtwist" target="_blank" rel="noopener">GitHub</a>
        <a href="https://linkedin.com/in/farandee/" target="_blank" rel="noopener">LinkedIn</a>
      </nav>
    </div>

    <footer class="left-foot">
      <span class="mark">FM</span>
      <p>© 2026 Farand Mahazalfaa. Built with Astro, deployed on GitHub Pages. Last updated November 2026.</p>
    </footer>
  </aside>

  <span class="notch" aria-hidden="true"></span>

  <!-- RIGHT -->
  <main class="panel" data-panel tabindex="-1">
    <button type="button" class="panel-close" data-close aria-label="Close panel">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
    </button>
    <p class="vertical">Data / Product / Design</p>

    <!-- HOME canvas -->
    <section class="view home" data-view="home" hidden aria-label="Introduction">
      <div class="stage" data-stage aria-hidden="true">
        {floatTools.map((t, i) => (
          <span class="float" style={`--x:${t.x}%;--y:${t.y}%;--d:${t.d};--delay:${i * -1.3}s`}>
            <span class="bob"><span class="tool-card glass"><TechIcon name={t.name} size={22} /></span></span>
          </span>
        ))}
        {cursors.map((c, i) => (
          <span class="float" style={`--x:${c.x}%;--y:${c.y}%;--d:${c.d};--delay:${i * -2.1}s`}>
            <span class="wander">
              <svg class="arrow" viewBox="0 0 16 16" style={`color:${c.color}`}><path d="M2 1.5l11 5.2-4.6 1.3L6.6 13z" /></svg>
              <span class="cursor-label" style={`background:${c.color};color:${c.ink}`}>{c.label}</span>
            </span>
          </span>
        ))}
        <span class="float" style="--x:7%;--y:44%;--d:8;--delay:-3s">
          <span class="bob">
            <span class="chat glass">
              <span class="chat-avatar">FM</span>
              <span class="chat-body">
                <span class="chat-head"><strong>Farand</strong> just now</span>
                <span>Pick a project on the left and I'll walk you through it.</span>
              </span>
            </span>
          </span>
        </span>
      </div>

      <h2 class="home-title">
        I make complex problems easier to <em>understand</em> and <em>use.</em>
      </h2>

      <div class="buddy" data-buddy>
        <p class="bubble glass-solid" data-bubble>Psst. You can <em>grab</em> me.</p>
        <canvas class="buddy-canvas" data-avatar="big" aria-label="Pixel avatar of Farand. Drag it around."></canvas>
      </div>
    </section>

    <div class="panel-inner">
      {works.map((w, i) => {
        const prev = works[(i - 1 + works.length) % works.length];
        const next = works[(i + 1) % works.length];
        return (
          <article class="view" data-view={`work/${w.slug}`} hidden>
            <figure class="frame glass">
              <div class="screen">
                {w.hero ? (
                  <>
                    <img src={url(w.hero)} alt={w.heroAlt ?? w.title} data-hero />
                    <canvas class="screen-canvas" data-reveal-img aria-hidden="true"></canvas>
                  </>
                ) : (
                  <>
                    <canvas class="screen-canvas pixelated" data-art data-seed={Number(w.number)} data-label={w.number} data-cols="240" data-reveal></canvas>
                    <span class="ph-label">{w.placeholderLabel ?? 'Visual to be added'}</span>
                  </>
                )}
                <span class="screen-meta left-meta">Work {w.number} / {total}</span>
                <span class="screen-meta right-meta">{code(w)}</span>
                <a class="step prev" href={url(`/work/${prev.slug}`)} data-view-link={`work/${prev.slug}`} aria-label={`Previous: ${prev.title}`}>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
                </a>
                <a class="step next" href={url(`/work/${next.slug}`)} data-view-link={`work/${next.slug}`} aria-label={`Next: ${next.title}`}>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
                </a>
              </div>
            </figure>

            <h2 class="view-title">{w.title}</h2>
            <dl class="work-meta">
              <div><dt>Year</dt><dd>{w.year}</dd></div>
              <div><dt>Role</dt><dd>{w.role}</dd></div>
              <div><dt>Context</dt><dd>{w.context}</dd></div>
            </dl>
            <hr />

            <div class="prose">
              <p class="lead">{w.intro}</p>
              <p>{w.problem}</p>
              <h3>What I did</h3>
              <ul>{w.contribution.map((c) => <li>{c}</li>)}</ul>
              <h3>Takeaway</h3>
              <p>{w.learning}</p>
            </div>

            <div class="actions">
              <a class="pill" href={url(`/work/${w.slug}`)}>Read full case study <span aria-hidden="true">→</span></a>
              {w.externalUrl && (
                <a class="pill ghost" href={w.externalUrl} target="_blank" rel="noopener">{w.externalLabel ?? 'Open link'} ↗</a>
              )}
            </div>
          </article>
        );
      })}

      <article class="view" data-view="experience" hidden>
        <p class="eyebrow">Experience</p>
        <h2 class="view-title">Where I've worked</h2>
        <hr />
        <ol class="timeline">
          {experience.map((e) => (
            <li class="t-card glass">
              <OrgLogo name={e.org} logo={e.logo} size={40} />
              <div>
                <p class="t-date">{e.date}</p>
                <h3>{e.role}</h3>
                <p class="t-org">{e.org}</p>
                <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </article>

      <article class="view" data-view="leadership" hidden>
        <p class="eyebrow">Leadership</p>
        <h2 class="view-title">Organizations</h2>
        <hr />
        <ol class="timeline">
          {leadership.map((e) => (
            <li class="t-card glass">
              <OrgLogo name={e.org} logo={e.logo} size={40} />
              <div>
                <p class="t-date">{e.date}</p>
                <h3>{e.role}</h3>
                <p class="t-org">{e.org}</p>
                <p class="t-desc">{e.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </article>

      <article class="view" data-view="toolkit" hidden>
        <p class="eyebrow">Toolkit</p>
        <h2 class="view-title">Tools I work with</h2>
        <hr />
        {toolGroups.map((g) => (
          <div class="tool-group">
            <h3>{g.label}</h3>
            <div class="tools">
              {g.tools.map((t) => (
                <span class="tool glass"><TechIcon name={t} size={18} />{t}</span>
              ))}
            </div>
          </div>
        ))}
      </article>

      <article class="view" data-view="about" hidden>
        <p class="eyebrow">About</p>
        <h2 class="view-title">Where data, design, and software overlap</h2>
        <hr />
        <div class="prose">
          <p class="lead">
            I'm a seventh-semester B.Sc. Data Science student at Telkom University. I enjoy projects
            where the technical work is only part of the problem: the analysis has to be understood,
            the system has to fit real constraints, and the result has to be usable by someone else.
          </p>
          <p>
            Before university, I studied Software Engineering at SMK Telkom Purwokerto. That
            background in web development, databases, and interface design still shapes how I work,
            whether I'm building a data product, mapping an urban problem, or directing a visual system.
          </p>
        </div>
        <dl class="facts glass">
          <div><dt>Current</dt><dd>B.Sc. Data Science, Telkom University</dd></div>
          <div><dt>Honors</dt><dd>Astra 1st 2026 Scholarship Awardee<br />Telkom University Endowment Fund 2026 Awardee</dd></div>
          <div><dt>Interested in</dt><dd>Data products, urban analytics, decision intelligence, visual communication</dd></div>
        </dl>
      </article>
    </div>
  </main>
</div>

<script>
  import { ditherInto, drawBust, drawArt, pixelReveal, reducedMotion } from '../../lib/dither';
  import { profile } from '../../data/profile';

  const INK = '#0b1533';
  const PAPER = '#f4f6fb';
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  const shell = document.querySelector<HTMLElement>('[data-shell]')!;
  const panel = document.querySelector<HTMLElement>('[data-panel]')!;
  const views = [...document.querySelectorAll<HTMLElement>('[data-view]')];
  const mobile = window.matchMedia('(max-width: 959px)');

  /* ---------- pixel artwork ---------- */
  const artCache = new Map<HTMLCanvasElement, HTMLCanvasElement>();
  function renderArt(c: HTMLCanvasElement) {
    const cols = Number(c.dataset.cols || 96);
    const src = drawArt(640, 400, Number(c.dataset.seed || 1), c.dataset.label || '');
    const dithered = document.createElement('canvas');
    ditherInto(dithered, src, 640, 400, { cols, ink: '#173a9e', paper: '#dbe6ff', contrast: 1.15 });
    artCache.set(c, dithered);
    c.width = dithered.width;
    c.height = dithered.height;
    c.getContext('2d')!.drawImage(dithered, 0, 0);
  }

  function loadImage(src: string) {
    return new Promise<HTMLImageElement>((resolve, reject) => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = src;
    });
  }

  async function avatarSource(): Promise<[CanvasImageSource, number, number]> {
    if (profile.cutout) {
      try {
        const img = await loadImage(base + profile.cutout);
        return [img, img.naturalWidth, img.naturalHeight];
      } catch {}
    }
    const bust = drawBust();
    return [bust, bust.width, bust.height];
  }

  async function renderAvatars() {
    const [src, w, h] = await avatarSource();
    document.querySelectorAll<HTMLCanvasElement>('[data-avatar]').forEach((c) => {
      const big = c.dataset.avatar === 'big';
      ditherInto(c, src, w, h, { cols: big ? 132 : 44, ink: INK, paper: PAPER, contrast: 1.1 });
    });
  }

  function revealView(view: HTMLElement) {
    view.querySelectorAll<HTMLCanvasElement>('canvas[data-reveal]').forEach((c) => {
      const art = artCache.get(c);
      if (art) pixelReveal(c, art, 1000);
    });
    view.querySelectorAll<HTMLCanvasElement>('canvas[data-reveal-img]').forEach(async (c) => {
      const img = c.parentElement!.querySelector<HTMLImageElement>('img[data-hero]')!;
      if (!img.complete) await new Promise((r) => img.addEventListener('load', r, { once: true }));
      const ratio = img.naturalHeight / img.naturalWidth;
      c.width = 220;
      c.height = Math.round(220 * ratio);
      c.classList.remove('done');
      pixelReveal(c, img, 900);
      setTimeout(() => c.classList.add('done'), reducedMotion() ? 0 : 900);
    });
  }

  /* ---------- view switching ---------- */
  function show(id: string | null, focus = false) {
    const target = id && views.find((v) => v.dataset.view === id);
    if (!target) {
      shell.classList.remove('panel-open');
      document.documentElement.classList.remove('lock');
      if (!mobile.matches) show('home');
      return;
    }
    const swap = () => {
      views.forEach((v) => (v.hidden = v !== target));
      panel.classList.toggle('at-home', id === 'home');
      document.querySelectorAll('[data-view-link]').forEach((a) => {
        a.toggleAttribute('aria-current', (a as HTMLElement).dataset.viewLink === id);
      });
      panel.scrollTop = 0;
    };
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !reducedMotion() && !mobile.matches) doc.startViewTransition(swap);
    else swap();
    revealView(target);
    if (mobile.matches) {
      shell.classList.add('panel-open');
      document.documentElement.classList.add('lock');
    }
    if (focus) panel.focus({ preventScroll: true });
  }

  const fromHash = () => decodeURIComponent(location.hash.slice(1)) || null;

  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-view-link]');
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    const id = link.dataset.viewLink!;
    if (fromHash() !== id) history.pushState(null, '', id === 'home' ? location.pathname : `#${id}`);
    show(id, true);
  });
  window.addEventListener('popstate', () => show(fromHash()));
  document.querySelector('[data-close]')!.addEventListener('click', () => {
    history.pushState(null, '', location.pathname + location.search);
    show(null);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && shell.classList.contains('panel-open')) {
      (document.querySelector('[data-close]') as HTMLButtonElement).click();
    }
  });
  mobile.addEventListener('change', () => show(fromHash()));

  /* ---------- filters + layout ---------- */
  const worksEl = document.querySelector<HTMLElement>('[data-works]')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  function applyFilters() {
    const active = chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.filter!);
    let visible = 0;
    document.querySelectorAll<HTMLElement>('[data-year-group]').forEach((group) => {
      let n = 0;
      group.querySelectorAll<HTMLElement>('li[data-cats]').forEach((li) => {
        const on = active.length === 0 || active.some((a) => li.dataset.cats!.split(' ').includes(a));
        li.hidden = !on;
        if (on) n++;
      });
      group.hidden = n === 0;
      visible += n;
    });
    empty.hidden = visible > 0;
  }
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      chip.setAttribute('aria-pressed', String(chip.getAttribute('aria-pressed') !== 'true'));
      applyFilters();
      worksEl.scrollTop = 0;
    })
  );
  document.querySelectorAll<HTMLButtonElement>('[data-layout]').forEach((btn, _, all) =>
    btn.addEventListener('click', () => {
      all.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      worksEl.dataset.layoutMode = btn.dataset.layout!;
    })
  );

  /* ---------- home: parallax ---------- */
  if (!reducedMotion()) {
    panel.addEventListener('pointermove', (e) => {
      if (!panel.classList.contains('at-home')) return;
      const r = panel.getBoundingClientRect();
      panel.style.setProperty('--mx', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
      panel.style.setProperty('--my', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
    });
  }

  /* ---------- home: draggable buddy ---------- */
  const buddy = document.querySelector<HTMLElement>('[data-buddy]')!;
  const bubble = document.querySelector<HTMLElement>('[data-bubble]')!;
  const bubbleDefault = bubble.innerHTML;
  const lines = ['Whoa, easy!', 'Wheee!', 'Okay, okay, I trust you.', 'Data people need fresh air too.'];
  let drag: { x: number; y: number; id: number } | null = null;
  let resetTimer = 0;
  const canvasEl = buddy.querySelector('canvas')!;
  canvasEl.addEventListener('pointerdown', (e) => {
    drag = { x: e.clientX, y: e.clientY, id: e.pointerId };
    canvasEl.setPointerCapture(e.pointerId);
    buddy.classList.add('dragging');
    bubble.textContent = lines[Math.floor(Math.random() * lines.length)];
    clearTimeout(resetTimer);
  });
  canvasEl.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const dx = e.clientX - drag.x;
    const dy = e.clientY - drag.y;
    buddy.style.setProperty('--dx', `${dx}px`);
    buddy.style.setProperty('--dy', `${dy}px`);
    buddy.style.setProperty('--rot', `${Math.max(-18, Math.min(18, dx / 14))}deg`);
  });
  const release = () => {
    if (!drag) return;
    drag = null;
    buddy.classList.remove('dragging');
    buddy.style.setProperty('--dx', '0px');
    buddy.style.setProperty('--dy', '0px');
    buddy.style.setProperty('--rot', '0deg');
    resetTimer = window.setTimeout(() => (bubble.innerHTML = bubbleDefault), 1800);
  };
  canvasEl.addEventListener('pointerup', release);
  canvasEl.addEventListener('pointercancel', release);

  /* ---------- boot ---------- */
  document.querySelectorAll<HTMLCanvasElement>('canvas[data-art]').forEach(renderArt);
  renderAvatars();
  const photo = document.querySelector<HTMLImageElement>('img[data-photo]');
  const photoCanvas = document.querySelector<HTMLCanvasElement>('[data-photo-reveal]');
  if (photo && photoCanvas) {
    const go = () => {
      photoCanvas.width = 120;
      photoCanvas.height = Math.round((120 * photo.naturalHeight) / photo.naturalWidth);
      pixelReveal(photoCanvas, photo, 1100);
      setTimeout(() => photoCanvas.classList.add('done'), 1100);
    };
    photo.complete ? go() : photo.addEventListener('load', go, { once: true });
  }
  show(fromHash() ?? (mobile.matches ? null : 'home'));
  requestAnimationFrame(() => shell.classList.add('ready'));
</script>

<style>
  .shell {
    --paper: #f5f6f8;
    --card: #ffffff;
    --ink: #0f1420;
    --ink-2: #545c6b;
    --ink-3: #8a91a0;
    --rule: #e2e5ea;
    --blue: #2261e9;
    --blue-deep: #1849c4;
    --blue-soft: #e8efff;
    --sky: #bcd4ff;
    --on-blue: #ffffff;
    --on-blue-2: rgba(255, 255, 255, .72);
    --on-blue-rule: rgba(255, 255, 255, .22);
    --c-data: #2261e9;
    --c-product: #12b886;
    --c-design: #f76707;
    --dither: #0b1533;
    --left-w: clamp(420px, 41vw, 620px);
    --gutter: clamp(22px, 2.6vw, 44px);
    --r: 18px;
    --ease: cubic-bezier(.16, 1, .3, 1);

    display: grid;
    grid-template-columns: var(--left-w) 1fr;
    height: 100svh;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
  }

  /* checker pattern used for Seb-style dithered drop shadows */
  .shell {
    --dither-pattern: repeating-conic-gradient(var(--dither) 0 25%, transparent 0 50%) 0 0 / 3px 3px;
  }

  /* ---------- entrance ---------- */
  .enter { opacity: 0; transform: translateY(14px); }
  .ready .enter {
    opacity: 1;
    transform: none;
    transition: opacity .7s var(--ease), transform .9s var(--ease);
    transition-delay: calc(var(--i) * 90ms);
  }

  /* ---------- glass (pseudo-element based so a dithered shadow can sit behind it) ---------- */
  .glass { position: relative; }
  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: rgba(255, 255, 255, .14);
    border: 1px solid rgba(255, 255, 255, .34);
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .35), 0 12px 32px rgba(8, 26, 84, .18);
  }

  /* ---------- left ---------- */
  .left {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(25% - 1px), rgba(15, 20, 32, .045) calc(25% - 1px) 25%),
      var(--paper);
  }
  .left-inner {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: none;
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.4vh, 28px);
    padding: clamp(28px, 4.5vh, 52px) var(--gutter) clamp(16px, 2vh, 24px);
  }

  .name {
    margin: 0;
    max-width: none;
    font-size: clamp(2rem, 3.1vw, 3.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.045em;
    white-space: nowrap;
  }
  .roles {
    margin: 12px 0 0;
    color: var(--blue);
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .intro {
    display: grid;
    grid-template-columns: clamp(76px, 6.4vw, 100px) 1fr;
    gap: 18px;
    margin-top: clamp(16px, 2.4vh, 24px);
    align-items: start;
  }
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 3px solid #fff;
    border-radius: 16px;
    background: var(--blue);
    box-shadow: 0 10px 26px rgba(34, 97, 233, .22), 0 0 0 1px var(--rule);
    transform: rotate(-3deg);
    transition: transform .4s var(--ease);
  }
  .portrait:hover { transform: rotate(0) scale(1.03); }
  .portrait canvas, .portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }
  .portrait canvas[data-avatar] { object-fit: contain; object-position: bottom; top: 8%; height: 92%; }
  [data-photo-reveal].done { opacity: 0; transition: opacity .4s; }
  .intro p { margin: 0; color: var(--ink-2); font-size: .92rem; line-height: 1.6; }
  .intro a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }

  /* works */
  .works { padding: 0; border: 0; flex: 1; min-height: 300px; display: flex; flex-direction: column; }
  .works-tab {
    position: relative;
    align-self: flex-start;
    max-width: none;
    margin: 0 0 -1px;
    padding: 10px 46px 8px 18px;
    border: 1.5px solid var(--ink);
    border-bottom: 0;
    border-radius: 12px 0 0 0;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.02em;
    background: var(--card);
    clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 100%, 0 100%);
    z-index: 1;
  }
  .works-tab::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 30px;
    height: 100%;
    background: linear-gradient(to top right, transparent calc(50% - 1px), var(--ink) calc(50% - .8px), var(--ink) calc(50% + .8px), transparent calc(50% + 1px));
  }
  .works-box {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    border: 1.5px solid var(--ink);
    border-radius: 0 var(--r) var(--r) var(--r);
    background: var(--card);
  }
  .works-box::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    transform: translate(7px, 7px);
    background: var(--dither-pattern);
    opacity: .35;
  }
  .works-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px 12px;
    border-bottom: 1px solid var(--rule);
  }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink-2);
    font: inherit;
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .2s, color .2s, border-color .2s, transform .2s var(--ease);
  }
  .chip:hover { color: var(--ink); border-color: var(--ink-3); transform: translateY(-1px); }
  .chip[aria-pressed='true'] { border-color: var(--blue); background: var(--blue); color: #fff; }
  .chip[aria-pressed='true'] .swatch { background: #fff; }
  .swatch { width: 8px; height: 8px; border-radius: 2px; display: inline-block; flex-shrink: 0; }
  .swatch-data { background: var(--c-data); }
  .swatch-product { background: var(--c-product); }
  .swatch-design { background: var(--c-design); }

  .view-toggle { display: flex; gap: 2px; padding: 3px; border-radius: 10px; background: var(--paper); flex-shrink: 0; }
  .view-toggle button {
    width: 28px;
    height: 26px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
  }
  .view-toggle button[aria-pressed='true'] { background: #fff; color: var(--blue); box-shadow: 0 1px 4px rgba(15, 20, 32, .12); }
  .view-toggle svg { width: 13px; height: 13px; fill: currentColor; }

  .works-scroll { flex: 1; min-height: 0; overflow-y: auto; padding: 6px 16px 18px; scrollbar-width: thin; }
  .year { display: flex; align-items: center; gap: 12px; margin: 12px 0 8px; color: var(--ink-3); font-size: .78rem; font-weight: 600; }
  .year::after { content: ''; flex: 1; height: 1px; background: var(--rule); }
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }

  .row {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: #fff;
    transition: border-color .2s, transform .3s var(--ease), box-shadow .3s var(--ease);
  }
  .row:hover { border-color: #c9d6f5; transform: translateX(3px); box-shadow: 0 6px 18px rgba(34, 97, 233, .08); }
  .row[aria-current] { border-color: var(--blue); background: var(--blue-soft); box-shadow: 0 0 0 1px var(--blue); }
  .row-tag {
    display: inline-block;
    padding: 4px 9px;
    border-bottom-right-radius: 10px;
    background: var(--paper);
    color: var(--ink-2);
    font-size: .6rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .row[aria-current] .row-tag { background: var(--blue); color: #fff; }
  .row-body { display: grid; grid-template-columns: 1fr 92px; gap: 14px; padding: 8px 12px 12px; align-items: end; }
  .row-text { display: grid; gap: 4px; min-width: 0; }
  .row-title { font-size: 1rem; font-weight: 600; letter-spacing: -.015em; }
  .row-summary { color: var(--ink-2); font-size: .8rem; line-height: 1.45; }
  .row-thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: #173a9e;
  }
  .row-thumb img, .row-thumb canvas { width: 100%; height: 100%; object-fit: cover; display: block; image-rendering: pixelated; }
  .row-thumb img { image-rendering: auto; }
  .row-cats { position: absolute; top: 8px; right: 10px; display: flex; gap: 3px; }

  [data-layout-mode='grid'] .rows { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  [data-layout-mode='grid'] .row-body { grid-template-columns: 1fr; }
  [data-layout-mode='grid'] .row-thumb { order: -1; aspect-ratio: 16 / 9; }
  [data-layout-mode='grid'] .row-summary { display: none; }
  [data-layout-mode='grid'] .row-title { font-size: .9rem; }
  [data-layout-mode='grid'] .row-cats { display: none; }
  .empty { color: var(--ink-3); font-size: .85rem; padding: 18px 0; }

  .links { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .links a {
    position: relative;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding-bottom: 3px;
  }
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: currentColor;
    transform-origin: left;
    transition: transform .35s var(--ease);
  }
  .links a:hover::after { transform: scaleX(.35); }
  .links a:hover, .links a[aria-current] { color: var(--blue); }

  .left-foot {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: center;
    padding: 14px var(--gutter);
    border-top: 1px solid var(--rule);
  }
  .mark { color: var(--blue); font-size: 1.5rem; font-weight: 800; letter-spacing: -.07em; }
  .left-foot p { margin: 0; color: var(--ink-3); font-size: .66rem; line-height: 1.5; letter-spacing: .03em; text-transform: uppercase; }

  .notch {
    position: absolute;
    left: var(--left-w);
    top: 50%;
    width: 18px;
    height: 36px;
    transform: translateY(-50%);
    background: var(--paper);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    z-index: 3;
  }

  /* ---------- right panel ---------- */
  .panel {
    --mx: 0;
    --my: 0;
    position: relative;
    isolation: isolate;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    color: var(--on-blue);
    outline: none;
    scrollbar-width: thin;
    scrollbar-color: var(--on-blue-rule) transparent;
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(12.5% - 1px), rgba(255, 255, 255, .07) calc(12.5% - 1px) 12.5%),
      radial-gradient(120% 80% at 85% 0%, #5b8cff 0%, transparent 55%),
      radial-gradient(90% 70% at 0% 100%, #1a47c2 0%, transparent 60%),
      var(--blue);
    background-attachment: local, fixed, fixed, fixed;
  }
  .panel-inner { max-width: 920px; margin: 0 auto; padding: clamp(28px, 4.5vh, 52px) clamp(48px, 5vw, 88px) 80px; }
  .panel.at-home .panel-inner { display: none; }
  .vertical {
    position: absolute;
    top: 50%;
    right: 14px;
    margin: 0;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    color: var(--on-blue-2);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .26em;
    text-transform: uppercase;
    pointer-events: none;
    z-index: 2;
  }
  .panel-close { display: none; }

  .view:not(.home) { animation: enter .5s var(--ease); }
  @keyframes enter { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  /* ---------- home canvas ---------- */
  .home { position: absolute; inset: 0; overflow: hidden; }
  .home[hidden] { display: none; }
  .stage { position: absolute; inset: 0; pointer-events: none; }
  .float {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(calc(var(--mx) * var(--d) * -1px), calc(var(--my) * var(--d) * -1px));
    transition: transform .6s var(--ease);
  }
  .ready .home .float { animation: pop .8s var(--ease) both; }
  .float:nth-child(2) { animation-delay: .08s !important; }
  .float:nth-child(3) { animation-delay: .16s !important; }
  .float:nth-child(4) { animation-delay: .24s !important; }
  .float:nth-child(5) { animation-delay: .32s !important; }
  .float:nth-child(6) { animation-delay: .4s !important; }
  .float:nth-child(n+7) { animation-delay: .5s !important; }
  @keyframes pop { from { opacity: 0; scale: .6; } to { opacity: 1; scale: 1; } }

  .bob { display: block; animation: bob 6s ease-in-out infinite; animation-delay: var(--delay); }
  @keyframes bob { 50% { translate: 0 -10px; } }
  .wander { display: flex; align-items: flex-start; animation: wander 9s ease-in-out infinite; animation-delay: var(--delay); }
  @keyframes wander {
    0%, 100% { translate: 0 0; }
    30% { translate: 26px 14px; }
    60% { translate: -14px 24px; }
  }

  .tool-card {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
  }
  .tool-card :global(.icon-tile) { border: 0; background: rgba(255, 255, 255, .92); box-shadow: none; }
  .arrow { width: 22px; height: 22px; fill: currentColor; stroke: #0b1533; stroke-width: .8; filter: drop-shadow(0 2px 3px rgba(0, 0, 0, .25)); }
  .cursor-label {
    margin: 16px 0 0 -4px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: .8rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .15);
  }
  .chat {
    display: flex;
    gap: 12px;
    align-items: center;
    width: max-content;
    max-width: 330px;
    padding: 12px 16px 12px 12px;
    border-radius: 16px;
    color: var(--on-blue);
    font-size: .86rem;
    line-height: 1.4;
  }
  .chat-avatar {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #0b1533;
    color: #fff;
    font-size: .74rem;
    font-weight: 700;
  }
  .chat-body { display: grid; gap: 2px; }
  .chat-head { color: var(--on-blue-2); font-size: .76rem; }
  .chat-head strong { color: var(--on-blue); margin-right: 6px; }

  .home-title {
    position: absolute;
    left: clamp(32px, 4vw, 64px);
    bottom: clamp(32px, 6vh, 64px);
    max-width: min(11ch, 52%);
    margin: 0;
    font-size: clamp(2.2rem, 3.9vw, 4.4rem);
    font-weight: 700;
    line-height: .98;
    letter-spacing: -.05em;
    color: #fff;
    z-index: 2;
  }
  .home-title em { font-style: normal; font-weight: 400; color: var(--sky); }
  .ready .home-title { animation: rise 1s var(--ease) .2s both; }
  @keyframes rise { from { opacity: 0; translate: 0 30px; } to { opacity: 1; translate: 0 0; } }

  .buddy {
    --dx: 0px;
    --dy: 0px;
    --rot: 0deg;
    position: absolute;
    right: clamp(30px, 5vw, 90px);
    bottom: -4%;
    width: clamp(220px, 23vw, 380px);
    transform: translate(var(--dx), var(--dy)) rotate(var(--rot));
    transform-origin: 50% 20%;
    transition: transform .7s cubic-bezier(.34, 1.56, .64, 1);
    z-index: 3;
  }
  .buddy.dragging { transition: transform .05s linear; }
  .buddy-canvas {
    display: block;
    width: 100%;
    image-rendering: pixelated;
    cursor: grab;
    touch-action: none;
  }
  .buddy.dragging .buddy-canvas { cursor: grabbing; }
  .ready .buddy { animation: rise 1.1s var(--ease) .35s both; }
  .bubble {
    position: absolute;
    bottom: 100%;
    margin-bottom: 18px;
    width: max-content;
    max-width: 260px;
    padding: 14px 20px;
    border-radius: 999px;
    background: #f4f6fb;
    color: #0b1533;
    font-size: 1rem;
    font-weight: 600;
    left: 0;
    right: 0;
    margin-inline: auto;
  }
  .bubble::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 18px;
    height: 12px;
    translate: -50% -1px;
    background: #f4f6fb;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }
  .bubble::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    transform: translate(6px, 6px);
    background: var(--dither-pattern);
  }
  .bubble :global(em), .bubble em { font-style: normal; color: var(--blue); }

  /* ---------- work view ---------- */
  .frame {
    margin: 0 0 clamp(26px, 3.5vh, 38px);
    padding: 10px;
    border-radius: 26px;
    view-transition-name: panel-frame;
  }
  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 18px;
    background: #0c2a7a;
  }
  .screen > img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .screen-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    object-fit: cover;
  }
  .screen-canvas[data-reveal-img] { transition: opacity .35s; }
  .screen-canvas.done { opacity: 0; }
  .ph-label {
    position: absolute;
    top: 16px;
    left: 18px;
    max-width: 34ch;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(11, 21, 51, .55);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: .72rem;
  }
  .screen-meta {
    position: absolute;
    bottom: 14px;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(11, 21, 51, .5);
    color: #fff;
    font-size: .66rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .left-meta { left: 16px; }
  .right-meta { right: 16px; }
  .step {
    position: absolute;
    top: 50%;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    transform: translateY(-50%) scale(.9);
    border-radius: 50%;
    background: rgba(255, 255, 255, .9);
    color: var(--blue);
    opacity: 0;
    transition: opacity .25s, transform .3s var(--ease);
  }
  .step svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; }
  .prev { left: 14px; }
  .next { right: 14px; }
  .screen:hover .step, .step:focus-visible { opacity: 1; transform: translateY(-50%) scale(1); }

  .eyebrow { margin: 0 0 10px; color: var(--on-blue-2); font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .view-title {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(2.2rem, 3.8vw, 3.8rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -.045em;
    view-transition-name: panel-title;
  }
  .work-meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 0; }
  .work-meta div {
    display: flex;
    gap: 8px;
    align-items: baseline;
    padding: 6px 12px;
    border: 1px solid var(--on-blue-rule);
    border-radius: 999px;
    background: rgba(255, 255, 255, .08);
  }
  .work-meta dt { color: var(--on-blue-2); font-size: .64rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .work-meta dd { margin: 0; color: #fff; font-size: .82rem; font-weight: 500; }
  hr { border: 0; height: 1px; margin: 26px 0; background: var(--on-blue-rule); }

  .prose { max-width: 64ch; color: var(--on-blue-2); font-size: .98rem; line-height: 1.7; }
  .prose p { margin: 0 0 16px; }
  .prose .lead { color: #fff; font-size: 1.16rem; line-height: 1.55; font-weight: 500; }
  .prose h3 { margin: 30px 0 10px; color: #fff; font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .prose ul { margin: 0; padding-left: 18px; }
  .prose li { margin-bottom: 6px; }
  .prose li::marker { color: var(--sky); }

  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 999px;
    background: #f4f6fb;
    color: #0b1533;
    font-size: .86rem;
    font-weight: 600;
    top: 0;
    left: 0;
    transition: top .3s var(--ease), left .3s var(--ease);
  }
  .pill::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    transform: translate(5px, 5px);
    background: var(--dither-pattern);
    transition: transform .3s var(--ease);
  }
  .pill:hover { top: -2px; left: -2px; }
  .pill:hover::before { transform: translate(7px, 7px); }
  .pill.ghost { background: transparent; color: #fff; border: 1px solid rgba(255, 255, 255, .5); }
  .pill.ghost::before { display: none; }

  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
